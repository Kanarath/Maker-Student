---
// Laboratorio de pilas y potencia: pilas de 1,5 V en serie o en paralelo y un motor que consume cierta corriente.
//   serie: las tensiones se suman (n × 1,5 V)
//   paralelo: la tensión se queda en 1,5 V (la carga total dura más, pero no sube el voltaje)
//   potencia eléctrica = tensión × corriente  (W = V × A)
// Los datos del motor son un ejemplo: en tu montaje, lee su tensión y su corriente en la etiqueta.
---

<div class="lab" data-pilas>
  <div class="head"><b>Laboratorio · Pilas y potencia</b><span class="muted">Cambia las pilas y mira la tensión y los vatios</span></div>

  <svg viewBox="0 0 800 300" role="img" aria-label="Pilas de 1,5 voltios conectadas a un motor; la tensión total y la potencia aparecen debajo">
    <rect x="0" y="0" width="800" height="300" fill="#05060a" />
    <g data-cells></g>
    <g data-motor>
      <circle cx="700" cy="130" r="42" fill="#d8382f" stroke="#0b0d12" stroke-width="3" />
      <text x="700" y="137" text-anchor="middle" fill="#fff" font-size="22" font-family="monospace" font-weight="700">M</text>
    </g>
    <text x="700" y="202" text-anchor="middle" fill="#a3a1b4" font-size="14" font-family="monospace">motor</text>
  </svg>

  <div class="ctrl">
    <fieldset>
      <legend>Conexión de las pilas</legend>
      <label class="rad"><input type="radio" name="pilas-mode" value="serie" checked data-mode /> En serie (una detrás de otra)</label>
      <label class="rad"><input type="radio" name="pilas-mode" value="paralelo" data-mode /> En paralelo (todas a la vez)</label>
    </fieldset>
    <label>Número de pilas de 1,5 V: <b data-n-v>4</b>
      <input type="range" min="1" max="6" value="4" data-n />
    </label>
    <label>Corriente que consume el motor: <b data-i-v>0,5</b> A
      <input type="range" min="1" max="20" value="5" data-i />
    </label>
  </div>

  <p class="out" aria-live="polite" data-out></p>
  <p class="ride muted" data-note></p>
</div>

<script>
  const NS = "http://www.w3.org/2000/svg";
  function mk(tag: string, attrs: Record<string, string | number>) {
    const el = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));
    return el;
  }
  const f = (n: number, d = 1) => n.toLocaleString("es-ES", { maximumFractionDigits: d });

  for (const root of document.querySelectorAll<HTMLElement>("[data-pilas]")) {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const cells = q<SVGGElement>("[data-cells]");
    const N = q<HTMLInputElement>("[data-n]");
    const I = q<HTMLInputElement>("[data-i]");
    const out = q<HTMLElement>("[data-out]");
    const note = q<HTMLElement>("[data-note]");
    const modes = root.querySelectorAll<HTMLInputElement>("[data-mode]");

    function cell(x: number, y: number, w: number, h: number) {
      const g = document.createElementNS(NS, "g");
      g.append(mk("rect", { x, y, width: w, height: h, rx: 6, fill: "#37b26c", stroke: "#0b0d12", "stroke-width": 2 }));
      g.append(mk("rect", { x: x + w, y: y + h / 2 - 8, width: 8, height: 16, fill: "#d5d9e2" }));
      const t = mk("text", { x: x + w - 12, y: y + h / 2 + 5, "text-anchor": "end", fill: "#05060a", "font-size": 15, "font-family": "monospace", "font-weight": 700 });
      t.textContent = "+";
      const m = mk("text", { x: x + 12, y: y + h / 2 + 5, fill: "#05060a", "font-size": 15, "font-family": "monospace", "font-weight": 700 });
      m.textContent = "−";
      g.append(t, m);
      return g;
    }

    function update() {
      const n = +N.value, amps = +I.value / 10;
      const mode = [...modes].find((m) => m.checked)!.value;
      q("[data-n-v]").textContent = String(n);
      q("[data-i-v]").textContent = f(amps);
      cells.replaceChildren();
      const wire = { stroke: "#ff8a1f", "stroke-width": 4, fill: "none", "stroke-linecap": "round", "stroke-linejoin": "round" };
      let volts: number;
      if (mode === "serie") {
        volts = n * 1.5;
        const w = Math.min(86, 560 / n - 8);
        for (let k = 0; k < n; k++) cells.append(cell(40 + k * (w + 8), 110, w, 40));
        // cable de vuelta y de ida al motor
        const end = 40 + n * (w + 8);
        cells.append(mk("path", { d: `M${end},130 L658,130`, ...wire, stroke: "#ff8a1f" }));
        cells.append(mk("path", { d: `M40,130 L28,130 L28,240 L700,240 L700,172`, ...wire, stroke: "#2de0f2" }));
      } else {
        volts = 1.5;
        const h = Math.min(34, 220 / n - 6);
        for (let k = 0; k < n; k++) cells.append(cell(60, 40 + k * (h + 8), 160, h));
        cells.append(mk("path", { d: `M228,${40 + h / 2} L260,${40 + h / 2} L260,${40 + (n - 1) * (h + 8) + h / 2}`, ...wire }));
        cells.append(mk("path", { d: `M260,130 L658,130`, ...wire }));
        cells.append(mk("path", { d: `M60,${40 + h / 2} L44,${40 + h / 2} L44,${40 + (n - 1) * (h + 8) + h / 2}`, ...wire, stroke: "#2de0f2" }));
        cells.append(mk("path", { d: `M44,${40 + (n - 1) * (h + 8) + h / 2} L44,250 L700,250 L700,172`, ...wire, stroke: "#2de0f2" }));
      }
      const watts = volts * amps;
      out.innerHTML = `Tensión: <b>${f(volts)} V</b> &nbsp;·&nbsp; Potencia: <b>${f(volts)} V × ${f(amps)} A = ${f(watts, 2)} W</b>`;
      let msg = mode === "serie"
        ? `En serie las tensiones se suman: ${n} × 1,5 V = ${f(volts)} V.`
        : `En paralelo la tensión no sube: sigue siendo 1,5 V, pero las pilas se reparten el trabajo y suelen durar más.`;
      if (volts > 9) msg += " Ojo: por encima de 9 V ya te sales de la zona cómoda para empezar. En tus montajes usa pocas pilas y comprueba lo que admite tu motor.";
      note.textContent = msg + " (El consumo del motor es un ejemplo: en el tuyo, mira su etiqueta.)";
    }

    N.addEventListener("input", update);
    I.addEventListener("input", update);
    modes.forEach((m) => m.addEventListener("change", update));
    update();
  }
</script>

<style>
  .lab { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; margin: 20px 0; overflow: hidden; }
  .head { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 14px; border-bottom: 1px solid var(--line); font-size: .9rem; }
  .head b { font-family: var(--font-head); color: var(--accent); }
  svg { display: block; width: 100%; height: auto; }
  .ctrl { display: grid; gap: 12px; padding: 12px 14px; }
  fieldset { border: 1px solid var(--line); border-radius: 4px; padding: 8px 12px 10px; margin: 0; min-width: 0; }
  legend { font: 600 .8rem var(--font-mono); color: var(--accent); padding: 0 6px; }
  label { display: block; font-size: .95rem; }
  .rad { display: flex; gap: 10px; align-items: center; min-height: 40px; }
  .rad input { width: 20px; height: 20px; accent-color: var(--accent); }
  input[type="range"] { display: block; width: 100%; accent-color: var(--accent); margin-top: 6px; height: 28px; }
  .out { margin: 0; padding: 12px 14px; border-top: 1px solid var(--line); font-size: 1.02rem; }
  .ride { margin: 0; padding: 0 14px 12px; font-size: .92rem; }
</style>
