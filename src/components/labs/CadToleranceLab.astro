---
// Laboratorio de la holgura: ¿entra un eje en un agujero impreso?
// Modelo simplificado: agujero impreso = agujero diseñado − encogimiento. Cuánto encoge depende de TU impresora
// (por eso el temario dice «haz una prueba pequeña primero»). Las cifras de los umbrales son orientativas.
// El hueco se dibuja multiplicado por 5 para que se vea.
---

<div class="lab" data-tol>
  <div class="head"><b>Laboratorio · Holgura</b><span class="muted">Diseña el agujero y mira si entra el eje</span></div>

  <svg viewBox="0 0 800 300" role="img" aria-label="Vista desde arriba de un eje redondo dentro de un agujero. El hueco entre ambos se dibuja ampliado cinco veces.">
    <rect x="0" y="0" width="800" height="300" fill="#05060a" />
    <g data-draw></g>
  </svg>

  <div class="ctrl">
    <fieldset>
      <legend>Tu diseño</legend>
      <label>Diámetro del eje: <b data-s-v>5</b> mm
        <input type="range" min="3" max="10" step="0.5" value="5" data-s />
      </label>
      <label>Holgura que añades al agujero: <b data-c-v>0</b> mm
        <input type="range" min="0" max="0.6" step="0.05" value="0" data-c />
      </label>
    </fieldset>
    <fieldset>
      <legend>Tu impresora (se mide con una prueba)</legend>
      <label>El agujero sale más pequeño: <b data-k-v>0,2</b> mm
        <input type="range" min="0" max="0.4" step="0.05" value="0.2" data-k />
      </label>
      <p class="hint">Cada impresora y cada material es distinto.</p>
    </fieldset>
  </div>

  <p class="out" aria-live="polite" data-out></p>
</div>

<script>
  const SVGNS = "http://www.w3.org/2000/svg";
  function mk(tag: string, attrs: Record<string, string | number>) {
    const el = document.createElementNS(SVGNS, tag);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));
    return el;
  }
  const fmt = (n: number, d = 2) => n.toLocaleString("es-ES", { minimumFractionDigits: d, maximumFractionDigits: d });

  for (const root of document.querySelectorAll<HTMLElement>("[data-tol]")) {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const g = q<SVGGElement>("[data-draw]");
    const s = q<HTMLInputElement>("[data-s]");
    const c = q<HTMLInputElement>("[data-c]");
    const k = q<HTMLInputElement>("[data-k]");
    const out = q<HTMLElement>("[data-out]");
    const PX = 22; // px por mm
    const EXA = 5; // aumento del hueco

    function update() {
      const shaft = +s.value, clr = +c.value, shr = +k.value;
      q("[data-s-v]").textContent = fmt(shaft, 1);
      q("[data-c-v]").textContent = fmt(clr);
      q("[data-k-v]").textContent = fmt(shr);
      const designed = shaft + clr;
      const printed = designed - shr;
      const gap = printed - shaft; // juego total (diámetro)
      const rShaft = (shaft / 2) * PX;
      const rHole = rShaft + (gap / 2) * PX * EXA; // hueco exagerado
      const rDes = rShaft + ((designed - shaft) / 2) * PX * EXA;
      g.replaceChildren();
      const cx = 400, cy = 150;
      // placa
      g.append(mk("rect", { x: 220, y: 20, width: 360, height: 260, rx: 10, fill: "#2f7fe0" }));
      g.append(mk("circle", { cx, cy, r: Math.max(rHole, 2), fill: "#05060a" }));
      // agujero diseñado (discontinuo)
      g.append(mk("circle", { cx, cy, r: Math.max(rDes, 2), fill: "none", stroke: "#2de0f2", "stroke-width": 3, "stroke-dasharray": "6 5" }));
      // eje
      g.append(mk("circle", { cx, cy, r: rShaft, fill: gap <= 0 ? "#ff5a4a" : "#f2b230", "fill-opacity": gap <= 0 ? 0.85 : 1, stroke: "#0b0d12", "stroke-width": 2 }));
      const lab = (x: number, y: number, t: string, col: string, anchor = "start") => {
        const el = mk("text", { x, y, fill: col, "font-size": 14, "font-family": "monospace", "text-anchor": anchor });
        el.textContent = t;
        g.append(el);
      };
      lab(24, 60, "eje", "#f2b230");
      lab(24, 80, `${fmt(shaft, 1)} mm`, "#f2b230");
      lab(24, 130, "agujero diseñado", "#2de0f2");
      lab(24, 150, `${fmt(designed)} mm (discontinuo)`, "#2de0f2");
      lab(24, 200, "agujero impreso", "#ffffff");
      lab(24, 220, `${fmt(printed)} mm`, "#ffffff");

      let v: string, cls: string;
      if (gap <= 0) { v = "✕ No entra: el agujero impreso es igual o más pequeño que el eje."; cls = "ko"; }
      else if (gap < 0.1) { v = "⚠ Muy justo: puede entrar solo a la fuerza o no entrar."; cls = "ko"; }
      else if (gap <= 0.4) { v = "✓ Encaja con un pequeño juego."; cls = "ok"; }
      else { v = "⚠ Demasiado suelto: el eje bailará dentro del agujero."; cls = "ko"; }
      out.innerHTML = `Diseñas el agujero de <b>${fmt(designed)} mm</b> y la impresora lo saca de <b>${fmt(printed)} mm</b>. Juego total: <b>${fmt(gap)} mm</b>.<br>${v}`;
      out.classList.toggle("ok", cls === "ok");
      out.classList.toggle("ko", cls === "ko");
    }
    for (const el of [s, c, k]) el.addEventListener("input", update);
    update();
  }
</script>

<style>
  .lab { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; margin: 20px 0; overflow: hidden; }
  .head { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 14px; border-bottom: 1px solid var(--line); font-size: .9rem; }
  .head b { font-family: var(--font-head); color: var(--accent); }
  svg { display: block; width: 100%; height: auto; }
  .ctrl { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 12px 14px; }
  fieldset { border: 1px solid var(--line); border-radius: 4px; padding: 8px 12px 12px; margin: 0; min-width: 0; }
  legend { font: 600 .8rem var(--font-mono); color: var(--accent); padding: 0 6px; }
  label { display: block; margin-top: 8px; font-size: .92rem; }
  input[type="range"] { display: block; width: 100%; accent-color: var(--accent); margin-top: 6px; height: 28px; }
  .hint { margin: 6px 0 0; font-size: .82rem; opacity: .75; }
  .out { margin: 0; padding: 12px 14px; border-top: 1px solid var(--line); font-size: 1.02rem; }
  .out.ok { background: #4ade8014; border-top-color: #4ade80; }
  .out.ko { background: #ff6b5a14; border-top-color: #ff6b5a; }
  @media (max-width: 560px) { .ctrl { grid-template-columns: 1fr; } }
</style>
