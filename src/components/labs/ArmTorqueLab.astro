---
// Laboratorio del par en el hombro: brazo horizontal con carga en la punta, peso propio en su centro y contrapeso opcional.
// par = peso × distancia (en g·cm; 1000 g·cm = 1 kg·cm). Para pasar a N·m: 1 kg·cm ≈ 0,098 N·m.
// El brazo se supone horizontal y estirado: es el caso más duro para el motor del hombro.
---

<div class="lab" data-torque>
  <div class="head"><b>Laboratorio · Par en el hombro</b><span class="muted">¿Llega tu servo? Cambia los datos y mira el margen</span></div>

  <svg viewBox="0 0 800 300" role="img" aria-label="Brazo horizontal con el hombro a la izquierda, la carga en la punta, el peso del brazo en su centro y un contrapeso opcional detrás del hombro">
    <rect x="0" y="0" width="800" height="300" fill="#05060a" />
    <rect x="150" y="150" width="14" height="130" fill="#6b7186" />
    <rect x="110" y="276" width="94" height="10" rx="3" fill="#6b7186" />
    <g data-arm>
      <rect data-beam x="157" y="136" width="400" height="28" rx="14" fill="#f2b230" />
      <g data-cw></g>
      <g data-load></g>
      <g data-self></g>
    </g>
    <circle cx="157" cy="150" r="14" fill="#2a2c35" stroke="#d5d9e2" stroke-width="3" />
    <text x="157" y="26" text-anchor="middle" fill="#a3a1b4" font-size="14" font-family="monospace">hombro</text>
    <g data-dim></g>
  </svg>

  <div class="ctrl">
    <fieldset>
      <legend>El brazo</legend>
      <label>Longitud: <b data-l-v>14</b> cm<input type="range" min="5" max="30" step="1" value="14" data-l /></label>
      <label>Peso del brazo: <b data-w-v>100</b> g<input type="range" min="0" max="400" step="10" value="100" data-w /></label>
      <label>Carga en la punta: <b data-m-v>100</b> g<input type="range" min="0" max="500" step="10" value="100" data-m /></label>
    </fieldset>
    <fieldset>
      <legend>Contrapeso y servo</legend>
      <label>Contrapeso detrás del hombro: <b data-c-v>0</b> g<input type="range" min="0" max="600" step="10" value="0" data-c /></label>
      <label>… a <b data-d-v>4</b> cm del eje<input type="range" min="1" max="10" step="1" value="4" data-d /></label>
      <label>Par del servo (según su ficha):
        <select data-s>
          <option value="1.5">1,5 kg·cm (servo muy pequeño)</option>
          <option value="3" selected>3 kg·cm</option>
          <option value="6">6 kg·cm</option>
          <option value="12">12 kg·cm</option>
          <option value="20">20 kg·cm</option>
        </select>
      </label>
    </fieldset>
  </div>

  <p class="out" aria-live="polite" data-out></p>
  <p class="ride muted" data-ride></p>
</div>

<script>
  const SVGNS = "http://www.w3.org/2000/svg";
  const X0 = 157, Y0 = 150;
  function mk(tag: string, attrs: Record<string, string | number>) {
    const el = document.createElementNS(SVGNS, tag);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));
    return el;
  }
  const f1 = (n: number) => n.toFixed(2).replace(".", ",");

  for (const root of document.querySelectorAll<HTMLElement>("[data-torque]")) {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const L = q<HTMLInputElement>("[data-l]"), Wt = q<HTMLInputElement>("[data-w]"), Ld = q<HTMLInputElement>("[data-m]");
    const C = q<HTMLInputElement>("[data-c]"), D = q<HTMLInputElement>("[data-d]"), S = q<HTMLSelectElement>("[data-s]");
    const out = q<HTMLElement>("[data-out]"), ride = q<HTMLElement>("[data-ride]");

    function arrow(g: Element, x: number, y1: number, y2: number, color: string, w: number) {
      g.append(mk("line", { x1: x, y1, x2: x, y2: y2 - 8, stroke: color, "stroke-width": w, "stroke-linecap": "round" }));
      g.append(mk("polygon", { points: `${x - 2.6 * w},${y2 - 12} ${x + 2.6 * w},${y2 - 12} ${x},${y2}`, fill: color }));
    }

    function update() {
      const l = +L.value, w = +Wt.value, m = +Ld.value, c = +C.value, d = +D.value, servo = +S.value;
      q("[data-l-v]").textContent = String(l);
      q("[data-w-v]").textContent = String(w);
      q("[data-m-v]").textContent = String(m);
      q("[data-c-v]").textContent = String(c);
      q("[data-d-v]").textContent = String(d);

      const px = 14; // px por cm
      const tipX = X0 + l * px;
      q("[data-beam]").setAttribute("width", String(l * px + 14));
      const gl = q<SVGGElement>("[data-load]"), gs = q<SVGGElement>("[data-self]"), gc = q<SVGGElement>("[data-cw]"), gd = q<SVGGElement>("[data-dim]");
      for (const g of [gl, gs, gc, gd]) g.replaceChildren();
      if (m > 0) arrow(gl, tipX, Y0 + 14, Y0 + 14 + 20 + m / 8, "#ff8a1f", 5);
      if (w > 0) arrow(gs, X0 + (l * px) / 2, Y0 + 14, Y0 + 14 + 14 + w / 10, "#2de0f2", 4);
      if (c > 0) {
        const cx = X0 - d * px;
        const hh = 14 + c / 20;
        gc.append(mk("rect", { x: cx - 18, y: Y0 + 14, width: 36, height: hh, rx: 4, fill: "#37b26c", stroke: "#0b0d12", "stroke-width": 2 }));
        gc.append(mk("line", { x1: cx, y1: Y0, x2: cx, y2: Y0 + 14, stroke: "#d5d9e2", "stroke-width": 3 }));
      }
      // cota de longitud
      gd.append(mk("line", { x1: X0, y1: 250, x2: tipX, y2: 250, stroke: "#e9edf5", "stroke-width": 2 }));
      gd.append(mk("line", { x1: X0, y1: 242, x2: X0, y2: 258, stroke: "#e9edf5", "stroke-width": 2 }));
      gd.append(mk("line", { x1: tipX, y1: 242, x2: tipX, y2: 258, stroke: "#e9edf5", "stroke-width": 2 }));
      const t = mk("text", { x: (X0 + tipX) / 2, y: 242, "text-anchor": "middle", fill: "#e9edf5", "font-size": 14, "font-family": "monospace" });
      t.textContent = `${l} cm`;
      gd.append(t);

      const parLoad = m * l, parSelf = (w * l) / 2, parCw = c * d;
      const net = parLoad + parSelf - parCw; // g·cm
      const kgcm = Math.abs(net) / 1000;
      const nm = kgcm * 0.0980665;
      const ratio = kgcm > 0 ? servo / kgcm : Infinity;
      let verdict: string, cls: string;
      if (kgcm < 0.005) { verdict = "Equilibrado: el servo casi no hace fuerza para sostenerlo."; cls = "ok"; }
      else if (ratio >= 2) { verdict = `✓ Con margen: el servo da ${f1(ratio)} veces lo necesario (se recomienda al menos 2).`; cls = "ok"; }
      else if (ratio >= 1) { verdict = `Justo: el servo da solo ${f1(ratio)} veces lo necesario. Sin margen se calienta y se frena. Acorta, aligera o añade contrapeso.`; cls = "warn"; }
      else { verdict = `✕ No llega: faltan ${f1(kgcm - servo)} kg·cm. Acorta el brazo, aligéralo, pon contrapeso o usa un servo más fuerte.`; cls = "bad"; }
      const sign = net < 0 ? " (el contrapeso gana: el par cambia de sentido)" : "";
      out.innerHTML = `Par = ${m} g × ${l} cm + ${w} g × ${l / 2} cm${c ? ` − ${c} g × ${d} cm` : ""} = <b>${Math.round(Math.abs(net))} g·cm = ${f1(kgcm)} kg·cm</b> ≈ ${f1(nm)} N·m${sign}<br>${verdict}`;
      out.className = "out " + cls;
      ride.textContent = `Con un margen de 2×, el servo debería dar al menos ${f1(kgcm * 2)} kg·cm. Prueba a duplicar la longitud dejando el resto igual: el par se duplica (par = peso × distancia).`;
    }

    for (const i of [L, Wt, Ld, C, D, S]) i.addEventListener("input", update);
    update();
  }
</script>

<style>
  .lab { background: var(--panel); border: 1px solid var(--line); border-radius: 4px; margin: 20px 0; overflow: hidden; }
  .head { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 14px; border-bottom: 1px solid var(--line); font-size: .9rem; }
  .head b { font-family: var(--font-head); color: var(--accent); }
  svg { display: block; width: 100%; height: auto; }
  .ctrl { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 12px 14px; }
  fieldset { border: 1px solid var(--line); border-radius: 4px; padding: 8px 12px 12px; margin: 0; min-width: 0; }
  legend { font: 600 .8rem var(--font-mono); color: var(--accent); padding: 0 6px; }
  label { display: block; margin-top: 8px; font-size: .92rem; }
  input[type="range"] { display: block; width: 100%; accent-color: var(--accent); margin-top: 6px; height: 28px; }
  select { display: block; width: 100%; margin-top: 6px; min-height: 36px; background: var(--panel-2); color: inherit; border: 1px solid var(--line); border-radius: 4px; padding: 4px 8px; }
  .out { margin: 0; padding: 12px 14px; border-top: 1px solid var(--line); font-size: 1.02rem; }
  .out.ok { background: #4ade8014; border-top-color: #4ade80; }
  .out.warn { background: #f2b23014; border-top-color: #f2b230; }
  .out.bad { background: #ff5a4a14; border-top-color: #ff5a4a; }
  .ride { margin: 0; padding: 0 14px 12px; font-size: .92rem; }
  @media (max-width: 560px) { .ctrl { grid-template-columns: 1fr; } }
</style>
