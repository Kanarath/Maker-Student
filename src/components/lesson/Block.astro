---
// Uno de los 6 bloques fijos de una lección. Uso en MDX: <Block kind="montaje"> … </Block>
const KINDS = {
  pieza: { n: 1, title: "El montaje", hint: "Lo que vas a construir" },
  concepto: { n: 2, title: "La idea", hint: "Qué pasa y por qué" },
  montaje: { n: 3, title: "Montaje guiado", hint: "Paso a paso, con lo nuevo en color" },
  version: { n: 4, title: "Tu versión", hint: "Cámbialo y predice qué pasará" },
  errores: { n: 5, title: "Errores típicos", hint: "Lo que suele salir mal y cómo se arregla" },
  calidad: { n: 6, title: "Comprueba y registra", hint: "Antes de dar tu montaje por bueno" },
} as const;

interface Props { kind: keyof typeof KINDS; title?: string }
const { kind, title } = Astro.props;
const k = KINDS[kind];
---

<section class="block" id={`b-${kind}`} data-kind={kind}>
  <header>
    <span class="num">{k.n}</span>
    <div>
      <small>{k.hint}</small>
      <h2>{title ?? k.title}</h2>
    </div>
  </header>
  <div class="content"><slot /></div>
</section>

<style>
  .block { margin: 52px 0; scroll-margin-top: 80px; }
  header { display: flex; gap: 14px; align-items: center; padding-bottom: 10px; border-bottom: 1px solid var(--line); margin-bottom: 18px; }
  .num { flex: none; width: 40px; height: 40px; display: grid; place-items: center; font: 600 1rem var(--font-mono); background: var(--accent); color: #0b0d12; border-radius: 4px; }
  small { font: .7rem var(--font-mono); color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
  /* !important: la página de lección da margen y borde a todos los h2 del contenido */
  h2 { font-size: 1.5rem; margin: 0 !important; border: 0 !important; padding: 0 !important; }
  .content :global(> p:first-child) { margin-top: 0; }
</style>
